# apps/web/.env.test.local — variables pour la suite de tests d'intégration (Vitest).
# Copier ce fichier en .env.test.local et renseigner les vraies valeurs (déjà gitignoré via le
# motif .env.*.local — ne JAMAIS committer .env.test.local).
#
# IMPORTANT : ne JAMAIS pointer DATABASE_URL/DIRECT_URL vers vivre_dev ou la production. Les
# tests créent et suppriment des lignes réelles (users, events, bookings, payments...).
#
# Option A (recommandée si Docker est disponible en local) : pnpm docker:up démarre un
# Postgres jetable sur localhost:5432, base "vivre_dev" par défaut — créez-y plutôt une base
# séparée "vivre_test" et pointez ces URLs dessus.
#
# Option B (utilisée pour la vérification Stage 1 dans cet environnement, Docker non
# disponible) : un schéma Postgres dédié "vivre_test" sur la MÊME instance Supabase que le
# développement, isolé des données réelles par le paramètre ?schema=vivre_test — jamais le
# schéma "public" utilisé par l'app. Voir DATABASE_URL/DIRECT_URL de apps/web/.env.local et
# ajoutez simplement "&schema=vivre_test" à la fin de chacune.

DATABASE_URL="postgresql://vivre_user:vivre_pass@localhost:5432/vivre_test?schema=public"
DIRECT_URL="postgresql://vivre_user:vivre_pass@localhost:5432/vivre_test?schema=public"
JWT_SECRET="CHANGE_ME_TEST_ONLY_NOT_PRODUCTION_SECRET"
